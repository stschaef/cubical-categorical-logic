+      -- by hand the same definition checks in under 0.1s.
+      elim F F-respects-axioms = elim' where
         F-respects-≈ : {x y : 𝓒 .ob} {f g : Hom[ 𝓒 , x ] y}
           (p : f ≈ g) →
           PathP
